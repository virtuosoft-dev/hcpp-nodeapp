#!/bin/bash

# Remove NVM, NodeJS, and PM2 (the system NodeJS in /usr/bin is left untouched)
rm -rf /opt/nvm

# Remove shell environment
rm -f /etc/profile.d/nvm.sh
sed -i '/^# begin hcpp-nodeapp$/,/^# end hcpp-nodeapp$/d' /etc/bash.bashrc

############################################
# Uninstall templates
############################################
rm -f /usr/local/hestia/data/templates/web/nginx/NodeApp.tpl
rm -f /usr/local/hestia/data/templates/web/nginx/NodeApp.stpl
