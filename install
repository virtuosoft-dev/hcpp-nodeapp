#!/bin/bash
set -eo pipefail
export DEBIAN_FRONTEND=noninteractive

# Pin NVM; bump deliberately. NodeJS 20 is EOL but still required by hcpp-ghost and hcpp-nodebb.
# Never remove the system NodeJS (/usr/bin/node); HestiaCP's web terminal depends on it.
NVM_VERSION="v0.40.8"
NODE_MAJORS=(20 22 24)
DEFAULT_MAJOR=24

############################################
# Shell environment (also migrates prior installs)
############################################

# Login shells
cat > /etc/profile.d/nvm.sh <<'EOT'
# Installed by hcpp-nodeapp; shared NVM in /opt/nvm
if ! type nvm > /dev/null 2>&1; then
    export NVM_DIR="/opt/nvm"
    [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
    [ -n "$BASH_VERSION" ] && [ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"
fi
EOT
chmod 644 /etc/profile.d/nvm.sh

# Interactive non-login bash shells; replace any prior hcpp-nodeapp block
sed -i '/^# begin hcpp-nodeapp$/,/^# end hcpp-nodeapp$/d' /etc/bash.bashrc
cat <<'EOT' >> /etc/bash.bashrc
# begin hcpp-nodeapp
[ -s /etc/profile.d/nvm.sh ] && . /etc/profile.d/nvm.sh
# end hcpp-nodeapp
EOT

############################################
# Install templates
############################################

apt-get install -y curl ca-certificates rsync
rsync -r ./nginx/ /usr/local/hestia/data/templates/web/nginx/

if [[ -s "/opt/nvm/nvm.sh" ]]; then
    echo "NodeApp appears to already be installed"
    exit
fi

############################################
# Install NVM, NodeJS, and PM2
############################################

# Install NVM directly into /opt/nvm without touching any profile files
mkdir -p /opt/nvm
curl -fsSL "https://raw.githubusercontent.com/nvm-sh/nvm/${NVM_VERSION}/install.sh" | NVM_DIR=/opt/nvm PROFILE=/dev/null bash
export NVM_DIR="/opt/nvm"
. "$NVM_DIR/nvm.sh" || true

# Install NodeJS versions
for major in "${NODE_MAJORS[@]}"; do
    nvm install "$major"
done
nvm alias default "$DEFAULT_MAJOR"

# Install PM2 once, under the default version; PM2 state is per user (~/.pm2)
nvm use default
npm install -g npm@latest pm2

# Read-only for users
chmod -R a+rX,go-w /opt/nvm

# Notify the admin (username is customizable); prefer ROOT_USER, else the first user with the admin role
ADMIN_USER=$(source /usr/local/hestia/conf/hestia.conf 2>/dev/null; echo "$ROOT_USER")
if [[ -z "$ADMIN_USER" ]]; then
    ADMIN_CONF=$(grep -l "^ROLE='admin'" /usr/local/hestia/data/users/*/user.conf 2>/dev/null | head -n 1 || true)
    [[ -n "$ADMIN_CONF" ]] && ADMIN_USER=$(basename "$(dirname "$ADMIN_CONF")")
fi
if [[ -n "$ADMIN_USER" ]]; then
    /usr/local/hestia/bin/v-add-user-notification "$ADMIN_USER" NodeApp "<span style=\"font-size:large;color:green;\">&#11042;</span> NodeApp plugin has finished installing."
fi
